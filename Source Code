using System;

namespace RetroArcade
{
    class Program
    {
        static Random rng = new Random();
        const int Width = 50;

        static void Main(string[] args)
        {
            bool running = true;

            while (running)
            {
                ShowMenu();
                Console.Write("\n  Select a game to play (1-4): ");
                string input = Console.ReadLine();
                int choice;

                if (!int.TryParse(input, out choice) || choice < 1 || choice > 4)
                {
                    Console.ForegroundColor = ConsoleColor.Yellow;
                    Console.WriteLine("\n  Invalid choice! Please enter a number from 1 to 4.");
                    Console.ResetColor();
                    ReturnToMenu();
                    continue;
                }

                switch (choice)
                {
                    case 1:
                        TicTacToe();
                        break;
                    case 2:
                        RockPaperScissors();
                        break;
                    case 3:
                        NumberGuessing();
                        break;
                    case 4:
                        running = false;
                        break;
                }
            }

            Console.Clear();
            Console.ForegroundColor = ConsoleColor.Red;
            Console.WriteLine("\n  Thanks for playing at the Retro Arcade! Goodbye!\n");
            Console.ResetColor();
        }

        static void Border()
        {
            Console.WriteLine("  " + new string('#', Width));
        }

        static void Row(string text)
        {
            Console.WriteLine("  #" + text.PadRight(Width - 2) + "#");
        }

        static void ShowMenu()
        {
            Console.Clear();
            Console.ForegroundColor = ConsoleColor.Red;

            Border();
            Row("  *  .  *  .  *  .  *  .  *  .  *  .  *  .  *");
            Row("");
            Row(@"         ___  ___  _____  ___   ___");
            Row(@"        | _ \| __||_   _|| _ \ / _ \");
            Row(@"        |   /| _|   | |  |   /| (_) |");
            Row(@"        |_|_\|___|  |_|  |_|_\ \___/");
            Row("");
            Row("            >>>  A R C A D E  <<<");
            Row("");
            Row("  *  .  *  .  *  .  *  .  *  .  *  .  *  .  *");
            Border();
            Row("");
            Row("          [1]  >>  Tic-Tac-Toe");
            Row("          [2]  >>  Rock-Paper-Scissors");
            Row("          [3]  >>  Number Guessing Game");
            Row("          [4]  >>  Exit Arcade");
            Row("");
            Border();
            Row("   INSERT COIN . PRESS A NUMBER . PLAY");
            Border();

            Console.ResetColor();
        }

        static void GameTitle(string title)
        {
            Console.Clear();
            Console.ForegroundColor = ConsoleColor.Red;
            Console.WriteLine();
            Border();
            Row("   " + title);
            Border();
            Console.ResetColor();
            Console.WriteLine();
        }

        static void ReturnToMenu()
        {
            Console.WriteLine("\n  Press Enter to return to the menu...");
            Console.ReadLine();
        }

        static void TicTacToe()
        {
            GameTitle("TIC-TAC-TOE");
            Console.WriteLine("  Instructions:");
            Console.WriteLine("  You are X, the computer is O.");
            Console.WriteLine("  Type a number from 1-9 to place your mark.\n");

            char[] board = { '1', '2', '3', '4', '5', '6', '7', '8', '9' };
            string result = "";

            while (result == "")
            {
                DrawBoard(board);

                int move = 0;
                bool valid = false;
                while (!valid)
                {
                    Console.Write("  Your move (1-9): ");
                    if (!int.TryParse(Console.ReadLine(), out move) || move < 1 || move > 9)
                    {
                        Console.WriteLine("  Invalid input! Enter a number from 1 to 9.");
                    }
                    else if (board[move - 1] == 'X' || board[move - 1] == 'O')
                    {
                        Console.WriteLine("  That spot is already taken!");
                    }
                    else
                    {
                        valid = true;
                    }
                }
                board[move - 1] = 'X';

                result = CheckBoard(board);
                if (result != "") break;

                int pc;
                do
                {
                    pc = rng.Next(0, 9);
                } while (board[pc] == 'X' || board[pc] == 'O');
                board[pc] = 'O';
                Console.WriteLine("  Computer chose " + (pc + 1) + "\n");

                result = CheckBoard(board);
            }

            DrawBoard(board);

            if (result == "X")
            {
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine("  YOU WIN!");
            }
            else if (result == "O")
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("  COMPUTER WINS!");
            }
            else
            {
                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.WriteLine("  IT'S A DRAW!");
            }
            Console.ResetColor();
            ReturnToMenu();
        }

        static void DrawBoard(char[] b)
        {
            Console.WriteLine("       " + b[0] + " | " + b[1] + " | " + b[2]);
            Console.WriteLine("      ---+---+---");
            Console.WriteLine("       " + b[3] + " | " + b[4] + " | " + b[5]);
            Console.WriteLine("      ---+---+---");
            Console.WriteLine("       " + b[6] + " | " + b[7] + " | " + b[8]);
            Console.WriteLine();
        }

        static string CheckBoard(char[] b)
        {
            int[,] lines =
            {
                {0,1,2}, {3,4,5}, {6,7,8},
                {0,3,6}, {1,4,7}, {2,5,8},
                {0,4,8}, {2,4,6}
            };

            for (int i = 0; i < 8; i++)
            {
                char a = b[lines[i, 0]];
                if (a == b[lines[i, 1]] && a == b[lines[i, 2]])
                {
                    return a.ToString();
                }
            }

            bool full = true;
            for (int i = 0; i < 9; i++)
            {
                if (b[i] != 'X' && b[i] != 'O') full = false;
            }

            return full ? "Draw" : "";
        }

        static void RockPaperScissors()
        {
            GameTitle("ROCK-PAPER-SCISSORS");
            Console.WriteLine("  Instructions:");
            Console.WriteLine("  Choose [1] Rock, [2] Paper, or [3] Scissors.");
            Console.WriteLine("  Rock beats Scissors, Scissors beats Paper, Paper beats Rock.\n");

            string[] names = { "Rock", "Paper", "Scissors" };
            int player = 0;
            bool valid = false;

            while (!valid)
            {
                Console.Write("  Your choice (1-3): ");
                if (!int.TryParse(Console.ReadLine(), out player) || player < 1 || player > 3)
                {
                    Console.WriteLine("  Invalid input! Enter 1, 2, or 3.");
                }
                else
                {
                    valid = true;
                }
            }

            int computer = rng.Next(1, 4);
            Console.WriteLine("\n  You chose      : " + names[player - 1]);
            Console.WriteLine("  Computer chose : " + names[computer - 1] + "\n");

            if (player == computer)
            {
                Console.ForegroundColor = ConsoleColor.Yellow;
                Console.WriteLine("  IT'S A TIE!");
            }
            else if ((player == 1 && computer == 3) ||
                     (player == 2 && computer == 1) ||
                     (player == 3 && computer == 2))
            {
                Console.ForegroundColor = ConsoleColor.Green;
                Console.WriteLine("  YOU WIN!");
            }
            else
            {
                Console.ForegroundColor = ConsoleColor.Red;
                Console.WriteLine("  YOU LOSE!");
            }
            Console.ResetColor();
            ReturnToMenu();
        }

        static void NumberGuessing()
        {
            GameTitle("NUMBER GUESSING GAME");
            Console.WriteLine("  Instructions:");
            Console.WriteLine("  I'm thinking of a number from 1 to 100.");
            Console.WriteLine("  Keep guessing until you find it!\n");

            int secret = rng.Next(1, 101);
            int attempts = 0;
            bool found = false;

            while (!found)
            {
                Console.Write("  Enter your guess: ");
                int guess;

                if (!int.TryParse(Console.ReadLine(), out guess) || guess < 1 || guess > 100)
                {
                    Console.WriteLine("  Invalid input! Enter a number from 1 to 100.");
                    continue;
                }

                attempts++;

                if (guess > secret)
                {
                    Console.WriteLine("  Too high!");
                }
                else if (guess < secret)
                {
                    Console.WriteLine("  Too low!");
                }
                else
                {
                    found = true;
                }
            }

            Console.ForegroundColor = ConsoleColor.Green;
            Console.WriteLine("\n  CONGRATULATIONS! You found " + secret + " in " + attempts + " attempt(s)!");
            Console.ResetColor();
            ReturnToMenu();
        }
    }
}
